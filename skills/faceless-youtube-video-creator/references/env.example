# Copy to `.env` in your project folder (the one with faceless-youtube.config.json) and fill in only what you use.
# Never commit it: first-run setup adds `.env` to the project's .gitignore.
#
# Every script reads variables the same way (scripts/env.mjs): a variable set in your shell or CI wins, then this
# file. `export NAME=value`, quotes and # comments are fine. Test the keys with:
#   node "${CLAUDE_SKILL_DIR}/scripts/providers.mjs" --check
# (free: it asks the provider whether the key works and can use the models; add --live for one tiny paid request
# that also confirms the account has credit).

# OpenAI: voices that act the script (openai:coral, openai:sage, openai:onyx) and generated illustrations.
# Models used: the config's "models" ({"speech": "gpt-4o-mini-tts", "image": "gpt-image-2.5-sunburst"}).
OPENAI_API_KEY=

# ElevenLabs: voices from your ElevenLabs library (elevenlabs:<voice id>).
ELEVENLABS_API_KEY=

# A Chrome or Chromium binary, only if Playwright can't find one.
# CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
